genfscon sysfs /devices/platform/soc/soc:fpc1020/wakeup                          u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/soc:goodix_fp/wakeup                        u:object_r:sysfs_wakeup:s0

# Touchscreen
genfscon proc /touchscreen                                                       u:object_r:vendor_proc_touchscreen:s0
genfscon sysfs /devices/virtual/touch/touch_dev                                  u:object_r:vendor_sysfs_touch:s0

# LiveDisplay
genfscon sysfs /devices/platform/soc/9c0000.qcom,qupv3_0_geni_se/984000.i2c/i2c-1/1-0036/hbm u:object_r:sysfs_livedisplay_tuneable:s0
